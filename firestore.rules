rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && 
             (request.auth.token.email == 'brokenheartisallthatleft200@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validations ---

    function isValidCheck(data) {
      // Relaxed for creation by non-admins to allow 'search' or 'failed' reports
      return data.keys().hasAll(['timestamp', 'status']);
    }

    // --- Collections ---

    match /checks/{checkId} {
      // Secure List Query Enforcement
      allow list: if isAdmin();
      allow get: if isAdmin();
      
      // Allow public logging of activity so it shows on admin panel
      allow create: if true && isValidCheck(incoming()); 
      
      allow update: if isAdmin() && 
                      isValidCheck(incoming());
                      
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      // Allow the user to see if they are an admin
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Creation/Update is locked. Managed by backend or manual console.
      allow write: if false;
    }
  }
}
